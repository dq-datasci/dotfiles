# ==========================================
# BI PROJECT AUTOMATION (V2 - Hybrid)
# ==========================================
function mkbi() {
    if [ -z "$1" ]; then
        echo "❌ Error: Please provide a project name."
        echo "👉 Usage: mkbi <project_name>"
        return 1
    fi

    local project_name="$1"
    local project_path="$(pwd)/$project_name"
    echo "🚀 Bootstrapping new full-stack BI project: $project_name..."

    # 1. Crear y entrar a la carpeta
    mkdir -p "$project_name"
    cd "$project_name" || return 1

    # 2. Inicializar Python con uv e instalar Radian local
    echo "🐍 Initializing Python environment with uv..."
    uv init
    echo "⬇️ Installing Python core & Local Radian..."
    uv add jupyterlab pandas numpy requests beautifulsoup4 radian

    # 3. Configurar variables de entorno y direnv
    echo "⚙️ Configuring environment variables (.envrc)..."
    echo 'export PROJECT_ENV="development"' > .envrc
    echo 'export RENV_CONFIG_PAK_ENABLED=true' >> .envrc
    echo 'export RETICULATE_PYTHON="./.venv/bin/python"' >> .envrc
    echo 'source .venv/bin/activate' >> .envrc
    direnv allow

    # 4. Automatizar configuración de Antigravity (VS Code)
    echo "🛠️ Configuring IDE settings & full debugger (.vscode/)..."
    mkdir -p .vscode
    
    # settings.json
    cat <<EOF > .vscode/settings.json
{
    "r.rterm.linux": "$project_path/.venv/bin/radian",
    "r.lsp.path": "$project_path/renv/library/linux-ubuntu-noble/R-4.5/x86_64-pc-linux-gnu/languageserver/bin/languageserver",
    "r.lsp.enabled": true,
    "r.plot.view": "httpgd"
}
EOF

    # launch.json (Incluyendo Package Debug y Attach)
    cat <<EOF > .vscode/launch.json
{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "R-Debugger",
            "name": "Launch R-Workspace",
            "request": "launch",
            "debugMode": "workspace",
            "workingDirectory": "\${workspaceFolder}"
        },
        {
            "type": "R-Debugger",
            "name": "Debug R-File",
            "request": "launch",
            "debugMode": "file",
            "workingDirectory": "\${workspaceFolder}",
            "file": "\${file}"
        },
        {
            "type": "R-Debugger",
            "name": "Debug R-Function",
            "request": "launch",
            "debugMode": "function",
            "workingDirectory": "\${workspaceFolder}",
            "file": "\${file}",
            "mainFunction": "main",
            "allowGlobalDebugging": false
        },
        {
            "type": "R-Debugger",
            "name": "Debug R-Package",
            "request": "launch",
            "debugMode": "workspace",
            "workingDirectory": "\${workspaceFolder}",
            "includePackageScopes": true,
            "loadPackages": ["."]
        },
        {
            "type": "R-Debugger",
            "request": "attach",
            "name": "Attach to R process",
            "splitOverwrittenOutput": true
        }
    ]
}
EOF

    # 5. Inicializar R con todas las herramientas de desarrollo
    echo "📦 Initializing R clean room..."
    Rscript -e "
    options(renv.config.pak.enabled = TRUE);
    renv::init(bare = TRUE);
    renv::install(c('tidyverse', 'reticulate', 'rmarkdown', 'here', 'languageserver', 'httpgd', 'vscDebugger'));
    renv::snapshot(prompt=FALSE);
    "

    echo "✅ Success! Project '$project_name' is isolated and fully equipped."
    echo "💻 Run 'ag .' to launch Google Antigravity."
}
